# Copy to .env for local testing (never commit the real .env — it's gitignored).
# In Coolify, set these as the app's environment variables instead of a file.

# From Retell dashboard → API Keys
RETELL_API_KEY=

# The demo agent's ID (see RETELL_AGENT_PROMPT.md for what to configure it with)
RETELL_AGENT_ID=

# Your deployed site's origin, no trailing slash. Locked down so only your
# site's browser requests are accepted. Use * only while testing.
ALLOWED_ORIGIN=https://practera.ai

# Guardrails — keep these conservative, this endpoint costs real money per call.
MAX_CALLS_PER_IP_PER_DAY=2
MAX_CALL_DURATION_SECONDS=90

PORT=8420
